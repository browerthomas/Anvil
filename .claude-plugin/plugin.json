{
  "name": "anvil",
  "version": "0.5.0",
  "description": "Forge ideas into shipped code. Plan → orchestrated execution → recap. An open framework for AI-orchestrated engineering work — markdown skills + bash + MCP, runs in any agent harness that speaks the open Agent Skills spec.",
  "tagline": "Plans come in raw. PRs come out forged.",
  "author": "anvil contributors",
  "license": "MIT",
  "homepage": "https://github.com/browerthomas/Anvil",
  "repository": "https://github.com/browerthomas/Anvil.git",
  "skills": [
    "skills/sweep-worktrees",
    "skills/self-review",
    "skills/recap",
    "skills/dispatch-slice",
    "skills/pre-merge-gate",
    "skills/auto-merge",
    "skills/spec",
    "skills/grind",
    "skills/findings-rollup",
    "skills/issue-to-spec",
    "skills/refine-plan",
    "skills/config-bootstrap",
    "skills/post-merge-debrief",
    "skills/dual-review",
    "skills/learn",
    "skills/lens",
    "skills/anvil-status",
    "skills/followup-rollup",
    "skills/plan-health"
  ],
  "templates": [
    "templates/plan-template.md"
  ],
  "examples": [
    "examples/example-plan.md",
    "examples/hello-world-plan.md"
  ],
  "requires": {
    "tools": ["gh", "git", "node", "npm", "jq"],
    "optional-tools": ["codex"],
    "claude-code-version": ">=1.0.0",
    "platforms": ["darwin", "linux"]
  }
}
